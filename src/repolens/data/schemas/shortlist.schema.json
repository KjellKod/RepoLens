{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repolens.example/schemas/shortlist-1.0.json",
  "title": "RepoLens shortlist",
  "type": "object",
  "required": ["schema_version", "generated_at", "open_count", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "open_count": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_ref", "reason", "evidence", "status"],
        "properties": {
          "component_ref": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "enum": ["BLOCK", "REVIEW", "UNKNOWN", "CONFLICT"]},
          "evidence": {
            "type": "object",
            "required": ["source_layer"],
            "properties": {
              "source_layer": {
                "type": "string",
                "enum": ["syft", "api", "mobile", "scancode", "agent"]
              },
              "url": {"type": "string"},
              "anchor": {"type": "string"},
              "note": {"type": "string"}
            },
            "additionalProperties": false
          },
          "candidate_spdx": {"type": ["string", "null"]},
          "status": {"type": "string", "enum": ["open", "approved", "rejected"]},
          "decided_by": {"type": ["string", "null"]},
          "decided_at": {"type": ["string", "null"]},
          "decided_via": {"type": ["string", "null"], "enum": ["group", "item", null]},
          "decision_provenance": {
            "type": "object",
            "required": ["component_refs", "found_in", "group"],
            "properties": {
              "component_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "found_in": {"type": "array", "items": {"type": "string"}},
              "group": {
                "type": "object",
                "required": ["spdx_family", "distribution", "scope"],
                "properties": {
                  "spdx_family": {"type": "string", "minLength": 1},
                  "distribution": {"type": "string", "minLength": 1},
                  "scope": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "ai_suggestion": {
            "type": "object",
            "required": [
              "component_ref",
              "spdx_id",
              "evidence_url",
              "evidence_anchor",
              "disposition",
              "confidence",
              "rationale",
              "sanity_check",
              "abstain",
              "reason",
              "invalid_reason"
            ],
            "properties": {
              "component_ref": {"type": "string"},
              "spdx_id": {"type": ["string", "null"]},
              "evidence_url": {"type": ["string", "null"]},
              "evidence_anchor": {"type": ["string", "null"]},
              "disposition": {"type": ["string", "null"]},
              "confidence": {"type": ["string", "number", "null"]},
              "rationale": {"type": ["string", "null"]},
              "sanity_check": {"type": ["string", "null"]},
              "abstain": {"type": "boolean"},
              "reason": {"type": ["string", "null"]},
              "invalid_reason": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "verify_reason": {"type": ["string", "null"]},
          "research_evidence": {
            "type": "object",
            "required": [
              "component_ref",
              "context_fingerprint",
              "package",
              "version",
              "ecosystem",
              "found_in",
              "outcome",
              "machine_verification",
              "lookups_attempted"
            ],
            "properties": {
              "component_ref": {"type": "string", "minLength": 1},
              "context_fingerprint": {"type": "string", "minLength": 12},
              "package": {"type": ["string", "null"]},
              "version": {"type": ["string", "null"]},
              "ecosystem": {"type": ["string", "null"]},
              "found_in": {"type": "array", "items": {"type": "string"}},
              "outcome": {
                "type": "string",
                "enum": [
                  "machine_verified",
                  "pending_verifier_support",
                  "no_public_evidence",
                  "conflict",
                  "legal_or_vendor_review"
                ]
              },
              "machine_verification": {
                "type": "string",
                "enum": [
                  "verified",
                  "pending_verifier_support",
                  "unsupported_evidence_source",
                  "no_public_evidence",
                  "conflict",
                  "legal_or_vendor_review"
                ]
              },
              "lookups_attempted": {"type": "array", "items": {"type": "string"}},
              "likely_spdx": {"type": ["string", "null"]},
              "confidence": {"type": ["string", "number", "null"]},
              "browser_evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "url", "source_type"],
                  "properties": {
                    "label": {"type": "string", "minLength": 1},
                    "url": {"type": "string", "minLength": 1},
                    "source_type": {"type": "string", "minLength": 1},
                    "anchor": {"type": ["string", "null"]},
                    "ref": {"type": ["string", "null"]}
                  },
                  "additionalProperties": false
                }
              },
              "conflicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["spdx_id", "label", "url"],
                  "properties": {
                    "spdx_id": {"type": "string", "minLength": 1},
                    "label": {"type": "string", "minLength": 1},
                    "url": {"type": "string", "minLength": 1},
                    "anchor": {"type": ["string", "null"]}
                  },
                  "additionalProperties": false
                }
              },
              "rationale": {"type": ["string", "null"]},
              "review_note": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
