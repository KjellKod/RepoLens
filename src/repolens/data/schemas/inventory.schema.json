{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repolens.example/schemas/inventory-1.0.json",
  "title": "RepoLens inventory",
  "type": "object",
  "required": ["schema_version", "generated_at", "components"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "license",
          "origin",
          "scope",
          "distribution",
          "versions",
          "source_url",
          "modified",
          "found_in"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "enum": ["third-party-oss", "first-party"]},
          "scope": {"type": "string", "enum": ["runtime", "dev", "build", "test", "unknown"]},
          "distribution": {
            "type": "string",
            "enum": ["server", "client-or-mobile", "not-distributed", "unknown"]
          },
          "versions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "source_url": {"type": "string", "minLength": 1},
          "modified": {
            "anyOf": [
              {"type": "boolean"},
              {"type": "string", "const": "unknown"}
            ]
          },
          "found_in": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "policy_tier": {"type": "string", "enum": ["ALLOW", "REVIEW", "BLOCK", "UNKNOWN"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "presence": {
            "type": "object",
            "required": [
              "install_state",
              "delivery_state",
              "relation",
              "path",
              "platform_match",
              "source",
              "target",
              "reopen_on_delivery_change"
            ],
            "properties": {
              "install_state": {
                "type": "string",
                "enum": ["installed", "not_installed", "lockfile_only", "unknown"]
              },
              "delivery_state": {
                "type": "string",
                "enum": ["delivered", "not_delivered", "not_scanned", "unknown"]
              },
              "relation": {
                "type": "string",
                "enum": [
                  "direct",
                  "transitive",
                  "peer",
                  "optional",
                  "dev",
                  "devOptional",
                  "mixed",
                  "unknown"
                ]
              },
              "path": {"type": "array", "items": {"type": "string"}},
              "platform_match": {
                "type": "string",
                "enum": ["target", "host", "cross_platform", "no", "unknown"]
              },
              "source": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "reopen_on_delivery_change": {"type": "boolean"},
              "delivery_artifact": {
                "type": "object",
                "properties": {
                  "kind": {"type": "string"},
                  "path": {"type": "string"},
                  "hash": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
