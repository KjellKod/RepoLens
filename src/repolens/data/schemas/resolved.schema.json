{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repolens.example/schemas/resolved-1.0.json",
  "title": "RepoLens resolved dependency record",
  "type": "object",
  "required": ["schema_version", "name", "version", "repo", "evidence", "tags", "modified"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "purl": {"type": "string"},
    "description": {"type": "string", "minLength": 1, "maxLength": 160},
    "declared_license_raw": {"type": ["string", "null"]},
    "declared_version_status": {"type": "string", "enum": ["declared-unpinned"]},
    "spdx_id": {"type": ["string", "null"]},
    "evidence": {
      "type": "object",
      "required": ["source_layer"],
      "properties": {
        "source_layer": {
          "type": "string",
          "enum": ["syft", "api", "mobile", "scancode", "agent"]
        },
        "url": {"type": "string"},
        "anchor": {"type": "string"},
        "fetched_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "required": ["origin", "scope", "distribution"],
      "properties": {
        "origin": {"type": "string", "enum": ["third-party-oss", "first-party"]},
        "scope": {"type": "string", "enum": ["runtime", "dev", "build", "test", "unknown"]},
        "distribution": {
          "type": "string",
          "enum": ["server", "client-or-mobile", "not-distributed", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "presence": {
      "type": "object",
      "required": [
        "install_state",
        "delivery_state",
        "relation",
        "path",
        "platform_match",
        "source",
        "target",
        "reopen_on_delivery_change"
      ],
      "properties": {
        "install_state": {
          "type": "string",
          "enum": ["installed", "not_installed", "lockfile_only", "unknown"]
        },
        "delivery_state": {
          "type": "string",
          "enum": ["delivered", "not_delivered", "not_scanned", "unknown"]
        },
        "relation": {
          "type": "string",
          "enum": [
            "direct",
            "transitive",
            "peer",
            "optional",
            "dev",
            "devOptional",
            "mixed",
            "unknown"
          ]
        },
        "path": {"type": "array", "items": {"type": "string"}},
        "platform_match": {
          "type": "string",
          "enum": ["target", "host", "cross_platform", "no", "unknown"]
        },
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "reopen_on_delivery_change": {"type": "boolean"},
        "delivery_artifact": {
          "type": "object",
          "properties": {
            "kind": {"type": "string"},
            "path": {"type": "string"},
            "hash": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "modified": {
      "anyOf": [
        {"type": "boolean"},
        {"type": "string", "const": "unknown"}
      ]
    }
  },
  "additionalProperties": false
}
