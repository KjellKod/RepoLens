{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repolens.example/schemas/resolved-1.0.json",
  "title": "RepoLens resolved dependency record",
  "type": "object",
  "required": ["schema_version", "name", "version", "repo", "evidence", "tags", "modified"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "purl": {"type": "string"},
    "declared_license_raw": {"type": ["string", "null"]},
    "declared_version_status": {"type": "string", "enum": ["declared-unpinned"]},
    "spdx_id": {"type": ["string", "null"]},
    "evidence": {
      "type": "object",
      "required": ["source_layer"],
      "properties": {
        "source_layer": {
          "type": "string",
          "enum": ["syft", "api", "mobile", "scancode", "agent"]
        },
        "url": {"type": "string"},
        "anchor": {"type": "string"},
        "fetched_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "required": ["origin", "scope", "distribution"],
      "properties": {
        "origin": {"type": "string", "enum": ["third-party-oss", "first-party"]},
        "scope": {"type": "string", "enum": ["runtime", "dev", "build", "test", "unknown"]},
        "distribution": {
          "type": "string",
          "enum": ["server", "client-or-mobile", "not-distributed", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "modified": {
      "anyOf": [
        {"type": "boolean"},
        {"type": "string", "const": "unknown"}
      ]
    }
  },
  "additionalProperties": false
}
