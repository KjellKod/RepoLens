{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repolens.example/schemas/shortlist-proposals-1.0.json",
  "title": "RepoLens external shortlist proposals",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "component_ref": {"type": "string"},
      "spdx_id": {"type": "string"},
      "evidence_url": {"type": "string"},
      "evidence_anchor": {"type": "string"},
      "disposition": {"type": "string"},
      "confidence": {"type": ["string", "number"]},
      "rationale": {"type": "string"},
      "sanity_check": {"type": "string"},
      "evidence_kind": {"type": "string", "enum": ["github_source_repo"]},
      "source_repo": {
        "type": "object",
        "required": [
          "host",
          "owner",
          "repo",
          "provenance",
          "provenance_detail",
          "bound_to_package"
        ],
        "properties": {
          "host": {"type": "string", "enum": ["github.com"]},
          "owner": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "ref_kind": {
            "type": ["string", "null"],
            "enum": ["version", "commit", "unknown", "default_branch", null]
          },
          "provenance": {"type": "string", "enum": ["package_metadata"]},
          "provenance_detail": {"type": "string", "minLength": 1},
          "bound_to_package": {"type": "boolean"}
        },
        "if": {
          "properties": {"ref_kind": {"enum": ["version", "commit"]}},
          "required": ["ref_kind"]
        },
        "then": {"required": ["ref"]},
        "additionalProperties": false
      },
      "abstain": {"type": "boolean"},
      "reason": {"type": "string"}
    },
    "additionalProperties": false
  }
}
