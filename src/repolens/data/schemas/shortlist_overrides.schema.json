{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repolens.example/schemas/shortlist-overrides-1.0.json",
  "title": "RepoLens shortlist human license overrides",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["component_ref", "spdx_id", "reason", "decided_by"],
    "properties": {
      "component_ref": {"type": "string", "minLength": 1},
      "spdx_id": {"type": "string", "minLength": 1},
      "evidence_url": {"type": "string", "minLength": 1},
      "evidence_note": {"type": "string", "minLength": 1},
      "reason": {"type": "string", "minLength": 1},
      "decided_by": {"type": "string", "minLength": 1},
      "expires_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    },
    "additionalProperties": false
  }
}
