    "CC-BY-NC-4.0": {"profile": "blocked_distribution"},
    "CC-BY-NC-SA-4.0": {"profile": "blocked_distribution"},
    "CC-BY-SA-4.0": {"profile": "share_alike_review"},
    "CC0-1.0": {"profile": "public_domain_style"},
    "CDDL-1.0": {"profile": "review_distribution"},
    "CECILL-2.1": {"profile": "review_distribution"},
    "CPL-1.0": {"profile": "review_distribution"},
    "EPL-1.0": {"profile": "review_distribution"},
    "EPL-2.0": {"profile": "review_distribution"},
    "EUPL-1.1": {"profile": "blocked_distribution"},
    "EUPL-1.2": {"profile": "review_distribution"},
    "Elastic-2.0": {"profile": "blocked_distribution"},
    "GPL-2.0-only": {"profile": "blocked_distribution"},
    "GPL-2.0-only WITH Classpath-exception-2.0": {"profile": "review_exception"},
    "GPL-2.0-or-later": {"profile": "blocked_distribution"},
    "GPL-3.0-only": {"profile": "blocked_distribution"},
    "GPL-3.0-only WITH Autoconf-exception-3.0": {"profile": "permissive_exception"},
    "GPL-3.0-or-later": {"profile": "blocked_distribution"},
    "HPND": {"profile": "permissive_notice"},
    "IPL-1.0": {"profile": "review_distribution"},
    "ISC": {"profile": "permissive_notice"},
    "LGPL-2.0-only": {"profile": "review_distribution"},
    "LGPL-2.0-or-later": {"profile": "review_distribution"},
    "LGPL-2.1-only": {"profile": "review_distribution"},
    "LGPL-2.1-or-later": {"profile": "review_distribution"},
    "LGPL-3.0-only": {"profile": "review_distribution"},
    "LGPL-3.0-or-later": {"profile": "review_distribution"},
    "Libpng": {"profile": "permissive_notice"},
    "MIT": {"profile": "permissive_notice"},
    "MIT-0": {"profile": "permissive_notice"},
    "MPL-1.1": {"profile": "review_distribution"},
    "MPL-2.0": {"profile": "review_distribution"},
    "MS-PL": {"profile": "review_distribution"},
    "MS-RL": {"profile": "review_distribution"},
    "OSL-3.0": {"profile": "blocked_distribution"},
    "PSF-2.0": {"profile": "permissive_notice"},
    "PolyForm-Noncommercial-1.0.0": {"profile": "blocked_distribution"},
    "PolyForm-Small-Business-1.0.0": {"profile": "blocked_distribution"},
    "Prosperity-3.0.0": {"profile": "blocked_distribution"},
    "Python-2.0": {"profile": "permissive_notice"},
    "RPL-1.5": {"profile": "blocked_distribution"},
    "SSPL-1.0": {"profile": "blocked_distribution"},
    "Unicode-3.0": {"profile": "review_distribution"},
    "Unlicense": {"profile": "public_domain_style"},
    "W3C": {"profile": "permissive_notice"},
    "X11": {"profile": "permissive_notice"},
    "ZPL-2.1": {"profile": "permissive_notice"},
    "Zlib": {"profile": "permissive_notice"},
    "curl": {"profile": "permissive_notice"}
  },
  "expression_rules": {
    "AND": "combine_most_restrictive",
    "OR": "chosen_or_min_risk_branch"
  },
  "target_contexts": {
    "cloudflare-worker": "delivered_distribution",
    "js-bundle": "delivered_distribution"
  },
  "unscanned_delivery_gate": "warn"
}
